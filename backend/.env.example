# NVIDIA NIM LLM Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=csv,xlsx,xls,json

# Supabase (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_STORAGE_BUCKET=datly-datasets

# Sarvam Voice API
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_STT_MODE=transcribe
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=24000
VOICE_MAX_AUDIO_SECONDS=30
VOICE_MAX_TTS_CHARACTERS=2500

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
